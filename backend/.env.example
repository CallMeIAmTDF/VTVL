# ==============================================================================
# CẤU HÌNH MẪU HỆ THỐNG AI & ĐƯỜNG DẪN PHÔI (FALLBACK KHI FRONTEND KHÔNG CUNG CẤP)
# Copy file này thành .env hoặc điền trực tiếp API Key vào .env
# ==============================================================================

# 1. Google AI Studio (Gemini API Key) - Dùng để bóc tách văn bản PDF/Word dài (Biểu A1, A2)
# Lấy key tại: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# 2. Groq API Key - Dùng để chuẩn hóa tên công việc & sinh giải trình hành chính tức thì (< 0.5s)
# Lấy key tại: https://console.groq.com/keys
GROQ_API_KEY=

# 3. Đường dẫn file phôi Excel chuẩn của Ban Tổ chức Trung ương (Tùy chọn)
# MASTER_TEMPLATE_PATH=../../07-HDVTVL/03. Bo bieu VTVL 19-10-2026.xlsx

